# Copy to .env.local and fill in. All three are public by design and ship in the
# client bundle; user data is protected by Postgres row-level security, not by
# hiding these. See docs/SETUP.md.

# Supabase → Connect dialog, or Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public half only. The private half goes to Supabase Edge Function secrets and a
# password manager — never here, never Netlify, never the repo. It cannot be recovered
# if lost; see "Rotating the VAPID keys" in docs/SETUP.md.
VITE_VAPID_PUBLIC_KEY=
